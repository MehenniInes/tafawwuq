"use client";
import { useEffect, useState } from "react";
import { useRouter } from "next/navigation";
import Link from "next/link";
import { supabase } from "@/lib/supabase";
import { ui } from "@/components/ui";

const DAYS = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
const DAY_ORDER = [6, 0, 1, 2, 3, 4, 5];

export default function NewGroup() {
  const router = useRouter();
  const [teachers, setTeachers] = useState<any[]>([]);
  const [teacherId, setTeacherId] = useState("");
  const [name, setName] = useState("");
  const [level, setLevel] = useState("");
  const [price, setPrice] = useState("");
  const [share, setShare] = useState("50");
  const [days, setDays] = useState<number[]>([]);
  const [start, setStart] = useState("");
  const [end, setEnd] = useState("");
  const [saving, setSaving] = useState(false);

  useEffect(() => {
    (async () => {
      const { data } = await supabase.auth.getSession();
      if (!data.session) return router.push("/login");
      const te = await supabase.from("teachers").select("id, name").order("name");
      setTeachers(te.data ?? []);
    })();
  }, [router]);

  function toggleDay(d: number) {
    setDays(days.includes(d) ? days.filter((x) => x !== d) : [...days, d]);
  }

  async function save() {
    if (!teacherId || !name.trim() || !price) return alert("Choose a teacher, and fill the subject and price");
    if (start && end && end <= start) return alert("End time must be after start time");
    setSaving(true);
    const { error } = await supabase.from("subjects").insert({
      teacher_id: teacherId,
      name: name.trim(),
      level: level || null,
      monthly_price: Number(price),
      teacher_share_percent: Number(share),
      days,
      start_time: start || null,
      end_time: end || null,
    });
    setSaving(false);
    if (error) return alert(error.message);
    router.push("/groups");
  }

  return (
    <main className={`${ui.page} pb-40`}>
      <Link href="/groups" className={ui.link}>
        Back to groups
      </Link>
      <h1 className={ui.title}>New group</h1>

      {teachers.length === 0 ? (
        <div className={`${ui.card} space-y-2`}>
          <p>You need a teacher first.</p>
          <Link href="/setup" className={ui.link}>
            Add a teacher
          </Link>
        </div>
      ) : (
        <>
          <div className={`${ui.card} space-y-3`}>
            <select className={ui.input} value={teacherId} onChange={(e) => setTeacherId(e.target.value)}>
              <option value="">Choose teacher</option>
              {teachers.map((t) => (
                <option key={t.id} value={t.id}>
                  {t.name}
                </option>
              ))}
            </select>
            <input className={ui.input} placeholder="Subject (e.g. Math)" value={name} onChange={(e) => setName(e.target.value)} />
            <input className={ui.input} list="levels" placeholder="Level (e.g. 3AS)" value={level} onChange={(e) => setLevel(e.target.value)} />
            <datalist id="levels">
              {["Primary", "1AM", "2AM", "3AM", "4AM", "1AS", "2AS", "3AS"].map((l) => (
                <option key={l} value={l} />
              ))}
            </datalist>
            <div className="grid grid-cols-2 gap-3">
              <div>
                <p className={ui.label}>Monthly price (DA)</p>
                <input className={`${ui.input} mt-1`} type="number" value={price} onChange={(e) => setPrice(e.target.value)} />
              </div>
              <div>
                <p className={ui.label}>Teacher gets (%)</p>
                <input className={`${ui.input} mt-1`} type="number" value={share} onChange={(e) => setShare(e.target.value)} />
              </div>
            </div>
          </div>

          <div className={`${ui.card} space-y-3`}>
            <p className={ui.label}>Days</p>
            <div className="flex flex-wrap gap-2">
              {DAY_ORDER.map((d) => (
                <button
                  key={d}
                  onClick={() => toggleDay(d)}
                  className={`rounded-xl border-2 px-4 py-2.5 text-sm font-semibold ${
                    days.includes(d)
                      ? "border-brand bg-brand text-white"
                      : "border-gray-200 bg-white text-gray-700"
                  }`}
                >
                  {DAYS[d]}
                </button>
              ))}
            </div>
            <div className="grid grid-cols-2 gap-3">
              <div>
                <p className={ui.label}>Starts</p>
                <input type="time" className={`${ui.input} mt-1`} value={start} onChange={(e) => setStart(e.target.value)} />
              </div>
              <div>
                <p className={ui.label}>Ends</p>
                <input type="time" className={`${ui.input} mt-1`} value={end} onChange={(e) => setEnd(e.target.value)} />
              </div>
            </div>
          </div>

          <div className="fixed inset-x-0 bottom-16 border-t border-gray-200 bg-white p-3">
            <div className="mx-auto max-w-lg">
              <button onClick={save} disabled={saving} className={ui.btn}>
                {saving ? "Saving..." : "Save group"}
              </button>
            </div>
          </div>
        </>
      )}
    </main>
  );
}